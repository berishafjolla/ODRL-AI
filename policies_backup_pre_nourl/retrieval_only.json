{
  "@context": ["http://www.w3.org/ns/odrl.jsonld", "https://w3id.org/odrl-ai/context"],
  "@type": "Agreement",
  "uid": "https://example.org/policy/aia-2026-001",
  "profile": "https://w3id.org/odrl-ai",
  "assigner": "ex:member-organisation-A",
  "assignee": "ex:advisory-service-provider",
  "target": "ex:operational-dataset-2026",
  "permission": [
    {
      "action": "aia:Retrieve",
      "constraint": [
        { "leftOperand": "aia:modelPurpose", "operator": "eq", "rightOperand": "aia:SectorAdvisory" },
        { "leftOperand": "aia:deploymentJurisdiction", "operator": "isPartOf", "rightOperand": "EU" }
      ],
      "duty": [{ "action": "aia:RecordProvenance" }]
    },
    { "action": "aia:Embed" }
  ],
  "prohibition": [
    { "action": "aia:Train" },
    { "action": "aia:FineTune" },
    { "action": "aia:Distill" }
  ]
}
